index 0000000..a035692
--- /dev/null
+++ b/tests/adapters/history-display-projection.test.ts
@@ -0,0 +1,172 @@
+import { describe, expect, it } from 'vitest';
+import {
+  DISPLAY_PROJECTION_MAX_DEPTH,
+  DISPLAY_PROJECTION_STATE_BYTES,
+  advanceDisplayProjection,
+  createDisplayProjectionState,
+  projectDisplayText,
+} from '../../src/adapters/storage/history-display-projection.js';
+
+const encoder = new TextEncoder();
+const bytes = (content: string): Uint8Array => encoder.encode(content);
+
+/** 把投影块按显示偏移拼回完整文本；块边界与窗口大小无关。 */
+function join(chunks: readonly { start: number; data: Uint8Array }[], byteLength: number): string {
+  const parts = [...chunks].sort((a, b) => a.start - b.start);
+  let at = 0;
+  const out: number[] = [];
+  for (const chunk of parts) {
+    expect(chunk.start).toBe(at);
+    out.push(...chunk.data);
+    at += chunk.data.length;
+  }
+  expect(at).toBe(byteLength);
+  return new TextDecoder('utf-8', { fatal: true }).decode(Uint8Array.from(out));
+}
+
+/**
+ * 用给定预算反复推进直到完成，返回拼回的文本。
+ *
+ * 每次推进都从 JSON 往返后的游标继续，因此这条路径就是旧历史补齐时走的路径。
+ */
+function project(body: string, budget: number, maxCalls = 20000): { text: string; calls: number; bytesPerCall: number[] } {
+  const source = bytes(body);
+  const read = (offset: number, length: number): Uint8Array => source.subarray(offset, offset + length);
+  let state = createDisplayProjectionState();
+  const chunks: { start: number; data: Uint8Array }[] = [];
+  const bytesPerCall: number[] = [];
+  let calls = 0;
+  for (; calls < maxCalls; calls += 1) {
+    const step = advanceDisplayProjection(JSON.parse(JSON.stringify(state)) as typeof state, read, budget);
+    expect(step.scannedBytes).toBeLessThanOrEqual(budget);
+    chunks.push(...step.chunks);
+    bytesPerCall.push(step.scannedBytes);
+    state = step.state;
+    if (step.complete) break;
+    if (step.scannedBytes === 0) throw new Error('projection made no progress');
+  }
+  expect(calls).toBeLessThan(maxCalls);
+  return { text: join(chunks, state.displayBytes), calls, bytesPerCall };
+}
+
+const blocks = (visible: readonly string[]): string =>
+  JSON.stringify(visible.map(text => ({ type: 'text', text })));
+
+/** 一次性投影：新提交与畸形正文的判定都走这条路径。 */
+function projectOnce(body: string): ReturnType<typeof projectDisplayText> {
+  const source = bytes(body);
+  return projectDisplayText((offset, length) => source.subarray(offset, offset + length), source.length);
+}
+
+describe('display projection', () => {
+  it('shows only visible text and joins blocks with one newline', () => {
+    const body = JSON.stringify([
+      { type: 'text', text: '第一段' },
+      { type: 'thinking', thinking: '不该显示的推理' },
+      { type: 'text', text: '' },
+      { type: 'tool_use', id: 'call_1', name: 'read', input: { path: '/tmp/x' } },
+      { type: 'text', text: '第二段' },
+    ]);
+    for (const budget of [1, 2, 3, 7, 16, 64, 4096])
+      expect(project(body, budget).text, 'budget ' + budget).toBe('第一段\n第二段');
+  });
+
+  it('excludes thought text blocks', () => {
+    const body = JSON.stringify([{ type: 'text', text: '可见', thought: true }, { type: 'text', text: '也可见' }]);
+    expect(project(body, 3).text).toBe('也可见');
+  });
+
+  it('decodes escapes and surrogate pairs at every window boundary', () => {
+    const body = JSON.stringify([{ type: 'text', text: 'a\nb\tc\\d"e' }, { type: 'text', text: '\u4f60\u597d🙂\ud83d\ude00' }]);
+    const expected = 'a\nb\tc\\d"e\n你好🙂😀';
+    for (let budget = 1; budget <= 40; budget += 1)
+      expect(project(body, budget).text, 'budget ' + budget).toBe(expected);
+  });
+
+  it('reads a thought key written with unicode escapes as thought', () => {
+    const body = '[{"type":"text","text":"a","thou\\u0067ht":true},{"type":"text","text":"b"}]';
+    expect(project(body, 3).text).toBe('b');
+  });
+
+  it('keeps a lone surrogate honest without truncating the rest of the text', () => {
+    const body = '[{"type":"text","text":"\\ud83d尾巴"}]';
+    for (let budget = 1; budget <= 12; budget += 1)
+      expect(project(body, budget).text, 'budget ' + budget).toBe('\uFFFD尾巴');
+  });
+
+  it('projects long text block by block without losing or duplicating a byte', () => {
+    const long = '中文🙂 line '.repeat(20000);
+    const body = blocks([long]);
+    expect(body.length).toBeGreaterThan(200000);
+    for (const budget of [16 * 1024, 4096, 37])
+      expect(project(body, budget).text, 'budget ' + budget).toBe(long);
+  });
+
+  it('never reads more than the batch budget per call', () => {
+    const body = blocks(['界'.repeat(200000), 'tail']);
+    const run = project(body, 64 * 1024);
+    // 一次调用最多读预算本身；半个转义的回看字节已从预算中扣除。
+    expect(Math.max(...run.bytesPerCall)).toBeLessThanOrEqual(64 * 1024);
+    expect(run.text).toBe('界'.repeat(200000) + '\ntail');
+  });
+
+  it('records a display range for every visible block', () => {
+    const body = blocks(['一', '二']);
+    const source = bytes(body);
+    const result = projectDisplayText((offset, length) => source.subarray(offset, offset + length), source.length);
+    expect(result.complete).toBe(true);
+    expect(result.mapping.map(span => [span.displayStart, span.displayEnd])).toEqual([[0, 3], [4, 7]]);
+    expect(result.mapping.map(span => new TextDecoder().decode(source.subarray(span.sourceStart, span.sourceEnd)))).toEqual(['一', '二']);
+  });
+
+  it('treats a body that is not a block array as having no projection', () => {
+    expect(project('{"type":"text","text":"x"}', 8).text).toBe('');
+  });
+
+  it('rejects nesting past the bound and keeps the resumable cursor bounded', () => {
+    const deep = '[{"type":"tool_use","input":' + '['.repeat(2000) + '0' + ']'.repeat(2000) + '},{"type":"text","text":"visible"}]';
+    const source = bytes(deep);
+    const step = advanceDisplayProjection(createDisplayProjectionState(), (offset, length) => source.subarray(offset, offset + length), 1600);
+    // 深度越界即拒绝；游标本身也保持在落盘预算内，旧历史补齐不会写出无界的行。
+    expect(step.state.scan.malformed).toBe(true);
+    expect(step.state.scan.stack.length).toBeLessThanOrEqual(DISPLAY_PROJECTION_MAX_DEPTH);
+    expect(Buffer.byteLength(JSON.stringify(step.state))).toBeLessThanOrEqual(DISPLAY_PROJECTION_STATE_BYTES);
+    // 上限之内的嵌套仍然照常投影。
+    const nested = { type: 'tool_use', id: 'call_1', name: 'read', input: Array.from({ length: 30 }, (_, index) => ({ n: index })) };
+    expect(project(JSON.stringify([nested, { type: 'text', text: '嵌套内' }]), 64).text).toBe('嵌套内');
+  });
+
+  it('never publishes a truncated prefix or trailing junk as a complete source', () => {
+    const rejected = [
+      '[{"type":"text","text":"可见"', // 缺最后的 ]
+      '[{"type":"text","text":"可见"},', // 尾逗号之后截断
+      '[{"type":"text","text":"可见"}]垃圾', // 根之后的尾随垃圾
+      '[{"type":"text","text":"可见"}] {}', // 根之后还有第二份 JSON
+      '[{"type":"text","text":"可见" "x":1}]', // 两个值之间缺逗号
+      '[{"type":"text","text":"可见",}]', // 对象尾逗号
+      '[,]', // 数组里的空位
+      '[{type:"text"}]', // 无引号键
+      '[{"type":"text","text":"坏\\q转义"}]', // 不认识的转义
+      '[{"type":"text","text":"坏\\u00转义"}]', // unicode 转义位数不足
+      '[{"type":"text","thought":tru}]', // 字面量没有闭合
+      '[{"type":"text","text":"换\n行"}]', // 字符串里未转义的换行
+      '[{"type":"text","text":"x"}}]', // 多余的闭合括号
+    ];
+    for (const body of rejected) {
+      const result = projectOnce(body);
+      expect(result.complete, body).toBe(false);
+      expect(result.state.scan.malformed, body).toBe(true);
+    }
+  });
+
+  it('keeps escaped UTF-8, CJK, numbers and literals valid', () => {
+    const body = JSON.stringify([
+      { type: 'text', text: '你好🙂é\u4f60', thought: false },
+      { type: 'tool_use', id: 'call_1', name: 'read', input: { delta: -1.5e3, ok: true, missing: null } },
+    ]);
+    const result = projectOnce(body);
+    expect(result.state.scan.malformed).toBe(false);
+    expect(result.complete).toBe(true);
+    expect(join(result.chunks, result.state.displayBytes)).toBe('你好🙂é\u4f60');
+  });
+});
diff --git a/tests/tui/status-line.test.tsx b/tests/tui/status-line.test.tsx
new file mode 100644
index 0000000..e856c9c
--- /dev/null
+++ b/tests/tui/status-line.test.tsx
@@ -0,0 +1,96 @@
+import { createElement } from 'react';
+import { expect, test } from 'vitest';
+
+import { StatusLine, formatContextStatus } from '../../src/interfaces/tui/components/status-line.js';
+import type { StatusLineProps } from '../../src/interfaces/tui/components/status-line.js';
+import type { ProjectContextStatus } from '../../src/application/tui/project-presentation.js';
+import { renderComponent, settle } from './harness.js';
+
+const baseProps: StatusLineProps = {
+  scope: {
+    coordinationScopeId: 'scope-1', revision: 3, mode: 'route_planning', controlState: 'active',
+    planningCycleId: 'cycle-1', mapRevision: 1, authorization: null, executionLeaseHolderSessionId: null,
+  },
+  compaction: null,
+  maintenance: null,
+  blockerCount: 0,
+  notice: null,
+  sidebarDensity: 'full',
+  availableWidth: 120,
+  execution: null,
+};
+
+const lastRequest = (overrides: Partial<Extract<ProjectContextStatus, { status: 'last_request' }>> = {}): ProjectContextStatus => ({
+  status: 'last_request', inputTokens: 12_000, outputTokens: 320, totalTokens: 12_320, capacity: 200_000,
+  coordinatorSessionId: 'session-a', modelConfigurationRef: 'config-a', stepId: 'step-1', ...overrides,
+});
+
+test('last request usage is labelled as history and never shown as a current percentage of an unknown window', () => {
+  expect(formatContextStatus(lastRequest(), 'used')).toContain('上次请求');
+  expect(formatContextStatus(lastRequest(), 'used')).toContain('输出 320');
+  expect(formatContextStatus(lastRequest({ capacity: null }), 'used')).toContain('窗口未知');
+  expect(formatContextStatus(lastRequest({ capacity: null }), 'used')).toContain('输入 12000');
+  expect(formatContextStatus({ status: 'unavailable' }, 'used')).toBe('上下文 不可用');
+});
+
+test('the status line shows the real turn state without dropping model, effort and context', async () => {
+  const presentation = {
+    identity: { repository: 'repo', fullBranchRef: 'refs/heads/main' },
+    session: { id: 'session-a', model: 'model-a', provider: 'provider-a', effort: { status: 'configured' as const, value: 'high' } },
+    ticket: null,
+    activeWorkPackages: [],
+    context: lastRequest(),
+    acceptance: null,
+    budgets: { workPackages: null, implementationAttempts: null, recovery: null },
+  };
+  const rendered = renderComponent(createElement(StatusLine, { ...baseProps, presentation }));
+  try {
+    await settle(2);
+    expect(rendered.lastFrame()).toContain('model-a');
+    expect(rendered.lastFrame()).toContain('上次请求');
+    expect(rendered.lastFrame()).not.toContain('运行中');
+  } finally {
+    rendered.unmount();
+  }
+
+  const running = renderComponent(createElement(StatusLine, {
+    ...baseProps, presentation, turn: { kind: 'running' },
+  }));
+  try {
+    await settle(2);
+    expect(running.lastFrame()).toContain('运行中');
+  } finally {
+    running.unmount();
+  }
+
+  const halted = renderComponent(createElement(StatusLine, {
+    ...baseProps, presentation, turn: { kind: 'halted', failure: { code: 'stopped', message: '用户停止' } },
+  }));
+  try {
+    await settle(2);
+    expect(halted.lastFrame()).toContain('轮次 已停止');
+  } finally {
+    halted.unmount();
+  }
+});
+
+test('窄屏时轮次标记仍然可见，代价是核心字段收缩', async () => {
+  const presentation = {
+    identity: { repository: 'repo', fullBranchRef: 'refs/heads/main' },
+    session: { id: 'session-a', model: 'model-with-a-long-name', provider: 'provider-a', effort: { status: 'configured' as const, value: 'high' } },
+    ticket: null,
+    activeWorkPackages: [],
+    context: lastRequest(),
+    acceptance: null,
+    budgets: { workPackages: null, implementationAttempts: null, recovery: null },
+  };
+  const narrow = renderComponent(createElement(StatusLine, {
+    ...baseProps, availableWidth: 50, presentation, turn: { kind: 'running' },
+  }));
+  try {
+    await settle(2);
+    expect(narrow.lastFrame()).toContain('运行中');
+  } finally {
+    narrow.unmount();
+  }
+});
diff --git a/tests/tui/transcript-mouse.test.ts b/tests/tui/transcript-mouse.test.ts
new file mode 100644
index 0000000..be93dc7
--- /dev/null
+++ b/tests/tui/transcript-mouse.test.ts
@@ -0,0 +1,75 @@
+import { describe, expect, test } from 'vitest';
+import { createMouseFilter, inTranscript, type TranscriptWheel } from '../../src/interfaces/tui/input/transcript-mouse.js';
+
+const ESC = String.fromCharCode(27);
+
+describe('transcript mouse input', () => {
+  test('consumes reports and preserves ordinary input across split reports', () => {
+    const wheels: TranscriptWheel[] = [], filter = createMouseFilter(wheel => wheels.push(wheel));
+    expect(filter('hello' + ESC + '[<64;')).toBe('hello');
+    expect(filter('3;5Mworld')).toBe('world');
+    expect(filter('[<65;3;5M')).toBe('');
+    expect(filter('[<0;3;5m')).toBe('');
+    expect(filter('literal [<tag> text')).toBe('literal [<tag> text');
+    expect(wheels).toEqual([{ x: 2, y: 4, direction: 'older' }, { x: 2, y: 4, direction: 'newer' }]);
+  });
+
+  test('报告在 `[<` 之前被终端读取切断时重组，不把协议字节写进 composer', async () => {
+    const wheels: TranscriptWheel[] = [];
+    // 原始输入刚以 ESC / ESC[ 结束：这就是 Ink 交付裸 `[` 的唯一依据。
+    let rawEscape = false;
+    const filter = createMouseFilter(wheel => wheels.push(wheel), () => { const value = rawEscape; rawEscape = false; return value; });
+    // 真实 Ink 场景：ESC[ 先到，150ms 后 <64;20;8M 才到。
+    expect(filter(ESC + '[')).toBe('');
+    rawEscape = true;
+    await new Promise(resolve => setTimeout(resolve, 150));
+    expect(filter('<64;20;8M')).toBe('');
+    expect(wheels).toEqual([{ x: 19, y: 7, direction: 'older' }]);
+
+    // ESC 单独到达时仍是普通按键；下一段补齐 `[<` 后整份报告被消费。
+    expect(filter(ESC)).toBe(ESC);
+    expect(filter('[<65;20;8M')).toBe('');
+    expect(wheels[1]).toEqual({ x: 19, y: 7, direction: 'newer' });
+
+    // 前缀之前的正文照常进入 composer，报告紧跟其后。
+    expect(filter('正文' + ESC + '[')).toBe('正文');
+    expect(filter('<64;1;1M')).toBe('');
+    expect(wheels).toHaveLength(3);
+
+    // 真实 Ink 交付路径：parseKeypress 已去掉 ESC，只剩 `[` 单独到达。
+    rawEscape = true;
+    expect(filter('[')).toBe('');
+    expect(filter('<64;20;8M')).toBe('');
+    expect(wheels[3]).toEqual({ x: 19, y: 7, direction: 'older' });
+
+    // 报告体本身被切断时前缀必须一起留着，否则只剩半截报告流入正文。
+    expect(filter(ESC + '[')).toBe('');
+    expect(filter('<64;20;')).toBe('');
+    expect(filter('8M')).toBe('');
+    expect(wheels[4]).toEqual({ x: 19, y: 7, direction: 'older' });
+  });
+
+  test('普通方括号正文原样进入 composer，不被前缀缓冲吞掉', () => {
+    const wheels: TranscriptWheel[] = [], filter = createMouseFilter(wheel => wheels.push(wheel));
+    // 没有未完成的 ESC 前缀：`[` 当场进入 composer，随后的 Enter 仍是独立提交键。
+    expect(filter('a[')).toBe('a[');
+    expect(filter('\r')).toBe('\r');
+    expect(filter('b]')).toBe('b]');
+    expect(filter('见 [tag] 与 [<3 文本')).toBe('见 [tag] 与 [<3 文本');
+    expect(wheels).toEqual([]);
+
+    // 待收缓冲有界：像报告体但超长的残片不再滞留，原样进入 composer。
+    const unbounded = '[<' + '1;'.repeat(60);
+    expect(filter(unbounded)).toBe(unbounded);
+    expect(filter('<64;20;8M')).toBe('<64;20;8M');
+  });
+
+  test('navigation is limited to the measured transcript rectangle', () => {
+    const region = { x: 2, y: 3, width: 20, height: 8 };
+    expect(inTranscript({ x: 2, y: 3, direction: 'older' }, region)).toBe(true);
+    for (const point of [{ x: 1, y: 3 }, { x: 22, y: 3 }, { x: 2, y: 11 }]) {
+      expect(inTranscript({ ...point, direction: 'older' }, region)).toBe(false);
+    }
+    expect(inTranscript({ x: 2, y: 3, direction: 'older' }, null)).toBe(false);
+  });
+});
