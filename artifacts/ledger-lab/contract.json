{
  "schemaVersion": 1,
  "name": "ledger-lab",
  "entry": "src/cli.mjs",
  "formats": ["json", "csv"],
  "versions": ["initial", "revised", "privacy"],
  "lineEndings": { "lf": "\n", "crlf": "\r\n" },
  "defaults": { "format": "json", "lineEnding": "lf" },
  "projections": {
    "aliasVersions": ["revised", "privacy"],
    "redactMerchantVersions": ["privacy"],
    "csvOrder": { "initial": "id-asc", "revised": "amount-desc", "privacy": "amount-desc" }
  },
  "limits": { "records": 100, "amountCents": 1000000, "thresholdCents": 1000000, "defaultThresholdCents": 5000 },
  "jsonFields": ["totalCents", "byCategory", "largePayments", "duplicateGroups"],
  "categoryFields": ["category", "count", "totalCents"],
  "csvColumns": ["id", "category", "merchant", "amountCents"],
  "aliases": { "餐饮": "food", "交通": "travel" },
  "redactedMerchant": "[redacted]",
  "outputSemantics": {
    "largePayments": "record-id-array; amountCents >= thresholdCents",
    "duplicateGroups": "array-of-id-arrays; same raw merchant and amountCents; minimum two records",
    "stringOrder": "UTF-16-code-unit",
    "strings": "trim only for nonempty validation; preserve original content",
    "jsonArrayComparison": "unordered; category names must be unique",
    "csvFinalNewline": "optional",
    "csvCategory": "raw",
    "successExitCode": 0,
    "errorExitCode": 2
  },
  "errorCodes": { "arguments": "INVALID_ARGUMENT", "read": "READ_ERROR", "json": "INVALID_JSON", "ledger": "INVALID_LEDGER" },
  "referenceGraph": {
    "S": { "lane": "coordination", "dependsOn": [] },
    "A": { "lane": "statistics", "dependsOn": ["S"] },
    "B": { "lane": "audit", "dependsOn": ["S"] },
    "C1": { "lane": "export", "dependsOn": ["S"] },
    "C2": { "lane": "export", "dependsOn": ["C1"] },
    "J": { "lane": "coordination", "dependsOn": ["A", "B"] },
    "D": { "lane": "coordination", "dependsOn": ["J", "C2"] },
    "R": { "lane": "coordination", "dependsOn": ["J"] }
  },
  "patch": { "add": "F", "lane": "statistics", "dependsOn": ["S"], "revise": "A", "revisedDependencies": ["S", "F"], "retire": "R" },
  "executionLimits": { "maxActiveWorkPackages": 8, "concurrencyLimit": 3, "perLane": 1, "implementationAttempts": 2, "validatorRepairs": 2, "graphRevisions": 2, "specificationRevisions": 2, "maxRecoveriesPerWorkerAttempt": 1 },
  "scenarios": [
    { "id": "planning", "title": "规划结构", "group": "core" },
    { "id": "parallel", "title": "跨 lane 并行", "group": "core" },
    { "id": "lane-capacity", "title": "每 lane 至多一个 Worker", "group": "core" },
    { "id": "local-block", "title": "局部阻塞与无关 lane 推进", "group": "core" },
    { "id": "joins", "title": "局部汇合与最终汇合", "group": "core" },
    { "id": "specification-revision", "title": "独立规格修订", "group": "core" },
    { "id": "graph-patch", "title": "原子 add/revise/retire", "group": "core" },
    { "id": "pause-resume", "title": "全局暂停与恢复", "group": "core" },
    { "id": "restart", "title": "退出重入与身份保持", "group": "core" },
    { "id": "recovery", "title": "Worker 同 Attempt 恢复", "group": "core" },
    { "id": "replanning", "title": "重规划与代际切换", "group": "core" },
    { "id": "budget", "title": "预算不重置", "group": "core" },
    { "id": "finalizer", "title": "独立交付结论", "group": "core" },
    { "id": "cancel", "title": "活跃 Worker 取消", "group": "cancel" },
    { "id": "retry", "title": "普通 Retry", "group": "conditional" },
    { "id": "validator-repair", "title": "Validator 修复与复验", "group": "conditional" },
    { "id": "unknown", "title": "unknown 原操作对账", "group": "conditional" },
    { "id": "escalation", "title": "Worker Escalation", "group": "conditional" },
    { "id": "handoff", "title": "Coordinator 交接", "group": "conditional" },
    { "id": "model-reauthorization", "title": "模型重新授权", "group": "conditional" }
  ]
}
