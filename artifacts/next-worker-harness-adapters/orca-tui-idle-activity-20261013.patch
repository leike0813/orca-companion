+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { OrcaRuntimeWithOnPtyData } from './orca-runtime-on-pty-data'
+import { OrcaRuntimeWithRecordPtyWorktree } from './orca-runtime-record-pty-worktree'
+import { OrcaRuntimeWithEmitDaemonPtyTransientFact } from './orca-runtime-emit-daemon-pty-transient-fact'
+import { makeTuiIdleLeaf, makeTuiIdlePty } from './tui-idle-wait-test-harness'
+import { leafTuiIdleEvidence, ptyTuiIdleEvidence, type TuiIdleEvidenceSource } from './tui-idle-evidence-source'
+import { evaluateTuiIdle } from './tui-idle-evidence'
+
+// Isolate ingestion and lifecycle from Electron, providers and the rest of the runtime chain.
+vi.mock('./orca-runtime', () => ({ OrcaRuntimeService: class {} }))
+vi.mock('./orca-runtime-prepare-pty-execution-context', () => ({ OrcaRuntimeWithPreparePtyExecutionContext: class {} }))
+vi.mock('./orca-runtime-refresh-repo-worktree-scan', () => ({ OrcaRuntimeWithRefreshRepoWorktreeScan: class {} }))
+vi.mock('./orca-runtime-schedule-wait-blocked-check', () => ({ OrcaRuntimeWithScheduleWaitBlockedCheck: class {} }))
+
+const PROTOCOLS = '\x1b[?2004h\x1b[>4;2m\x1b[=1;1u'
+const COMPOSER = ['────────────', '>', '────────────', '? for shortcuts']
+const TAIL = {
+  tailBuffer: [], tailTranscriptBuffer: [], tailTranscriptChars: 0,
+  tailPartialLine: '', tailPendingAnsi: '', tailRedrawCursor: null,
+  tailTruncated: false, tailLinesTotal: 0, preview: '', waitBlockedAt: null,
+}
+
+class Records extends OrcaRuntimeWithRecordPtyWorktree {
+  readonly pty = makeTuiIdlePty({ ...TAIL, incarnationId: 'incarnation-1' })
+  readonly ptysById = new Map([[this.pty.ptyId, this.pty]])
+  readonly wslDistroByPtyId = new Map()
+  invalidatePtyIncarnationHandle() {}
+  record(ptyId: string, worktreeId: string, state = {}) {
+    return this.recordPtyWorktree(ptyId, worktreeId, state)
+  }
+}
+
+class Ingestion extends OrcaRuntimeWithOnPtyData {
+  readonly records = new Records()
+  readonly leaf = makeTuiIdleLeaf(TAIL)
+  readonly ptyOutputSequenceById = new Map()
+  readonly providerModeTrackersByPtyId = new Map()
+  readonly providerModeSnapshotScansByPtyId = new Map()
+  readonly oscTitleScanTailByPtyId = new Map()
+  readonly forwarded: string[] = []
+  readonly terminalStreamConsumers = { publish: (_id: string, data: string) => this.forwarded.push(data) }
+  readonly graphSequence = 0
+  readonly graphStatus = 'ready'
+  recordOsc7MetadataForPty() { return { cwd: null, cwdChanged: false } }
+  processAgentStatusOscForPty(_id: string, data: string) {
+    return { cleanData: data, payloads: [], lastPayloadCleanOffset: null }
+  }
+  recordRecentPtyOutputForPathProvenance() {}
+  shouldAnswerQueriesForLiveChunk() { return false }
+  maybeHydrateHeadlessFromRenderer() {}
+  trackHeadlessTerminalData() { return Promise.resolve() }
+  getOrCreatePtyWorktreeRecord() { return this.records.pty }
+  getLeavesForPty() { return [this.leaf] }
+  recordPtyWorktree(id: string, worktreeId: string, state = {}) {
+    return this.records.record(id, worktreeId, state)
+  }
+  makeRuntimePaneKey() { return 'pane-1' }
+  scheduleWaitBlockedCheck() {}
+  getOrCreatePtyTitleTrackerEntry() {
+    return { tracker: { handleChunk() {} }, pendingFacts: [], chunkTouchedSessionTabs: false }
+  }
+  emitTerminalAgentStatusEvents() {}
+  restoreAgentPromptLifecycleByteOrder() {}
+  flushPendingTerminalSideEffectFacts() {}
+}
+
+function source(runtime: Ingestion): TuiIdleEvidenceSource {
+  return {
+    quiescenceMs: 3000,
+    getOutputActivity: () => runtime.records.pty.outputActivity,
+    getTabTitle: () => null,
+    getAdoptedPtyIdleStatus: () => null,
+    getPaneAgent: () => 'antigravity',
+    getFirstPartyAgentStatus: () => null,
+    readScreenLines: () => null,
+    readRuledScreen: () => ({ lines: COMPOSER, alternateScreen: false }),
+  }
+}
+
+class Gaps extends OrcaRuntimeWithEmitDaemonPtyTransientFact {
+  readonly oscTitleScanTailByPtyId = new Map()
+  readonly osc7ScanTailByPtyId = new Map()
+  readonly agentStatusOscProcessorsByPtyId = new Map()
+  readonly ptyOutputSequenceById = new Map()
+  constructor(private readonly ingestion: Ingestion) { super() }
+  getOrCreatePtyWorktreeRecord() { return this.ingestion.records.pty }
+  getLeavesForPty() { return [this.ingestion.leaf] }
+  disposeHeadlessTerminal() {}
+}
+
+describe('raw PTY ingestion and activity readiness', () => {
+  afterEach(() => vi.useRealTimers())
+
+  it('preserves raw bytes and both raw clocks while PTY and leaf readiness use the same activity', () => {
+    vi.useFakeTimers()
+    const runtime = new Ingestion()
+    const pty = runtime.records.pty
+    for (const at of [0, 2000, 4000, 6000]) {
+      vi.setSystemTime(at)
+      runtime.onPtyData(pty.ptyId, PROTOCOLS, at)
+      expect(pty.lastOutputAt).toBe(at)
+      expect(runtime.leaf.lastOutputAt).toBe(at)
+      for (const evidence of [
+        ptyTuiIdleEvidence(source(runtime), pty, () => ''),
+        leafTuiIdleEvidence(source(runtime), runtime.leaf, () => ''),
+      ]) {
+        expect(evaluateTuiIdle(evidence).kind).toBe(at < 3000 ? 'pending' : 'ready-strong')
+      }
+    }
+    expect(runtime.forwarded.join('')).toBe(PROTOCOLS.repeat(4))
+  })
+
+  it('keeps a same-incarnation reattach, but refuses the old clock and split escape after replacement', () => {
+    vi.useFakeTimers()
+    const runtime = new Ingestion()
+    const pty = runtime.records.pty
+    const verdict = () => evaluateTuiIdle(ptyTuiIdleEvidence(source(runtime), pty, () => '')).kind
+    runtime.onPtyData(pty.ptyId, PROTOCOLS, 0)
+    vi.setSystemTime(6000)
+    runtime.records.record(pty.ptyId, 'worktree-1', { incarnationId: 'incarnation-1' })
+    expect(verdict()).toBe('ready-strong')
+    runtime.onPtyData(pty.ptyId, '\x1b[?2004', 6000)
+    expect(verdict()).toBe('pending')
+    vi.setSystemTime(10000)
+    runtime.records.record(pty.ptyId, 'worktree-1', { incarnationId: 'incarnation-2' })
+    expect(verdict()).toBe('pending')
+    runtime.onPtyData(pty.ptyId, 'h', 10000)
+    vi.setSystemTime(12999)
+    expect(verdict()).toBe('pending')
+    vi.setSystemTime(13000)
+    expect(verdict()).toBe('ready-strong')
+  })
+
+  it('discards split protocol state and old quiet evidence across a dropped-output gap', () => {
+    vi.useFakeTimers()
+    const runtime = new Ingestion()
+    const pty = runtime.records.pty
+    const verdict = () => evaluateTuiIdle(ptyTuiIdleEvidence(source(runtime), pty, () => '')).kind
+    runtime.onPtyData(pty.ptyId, PROTOCOLS, 0)
+    runtime.onPtyData(pty.ptyId, '\x1b[?2004', 2000)
+    new Gaps(runtime).notePtyDataGap(pty.ptyId, 10)
+    vi.setSystemTime(6000)
+    expect(verdict()).toBe('pending')
+    runtime.onPtyData(pty.ptyId, PROTOCOLS, 6000)
+    runtime.onPtyData(pty.ptyId, PROTOCOLS, 8000)
+    vi.setSystemTime(8999)
+    expect(verdict()).toBe('pending')
+    vi.setSystemTime(9000)
+    expect(verdict()).toBe('ready-strong')
+  })
+})
