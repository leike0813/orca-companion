diff --git a/src/main/runtime/tui-idle-protocol-output.test.ts b/src/main/runtime/tui-idle-protocol-output.test.ts
new file mode 100644
index 0000000..027ef0b
--- /dev/null
+++ b/src/main/runtime/tui-idle-protocol-output.test.ts
@@ -0,0 +1,194 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { createTerminalEscapeScanner } from '../../shared/terminal-escape-scanner'
+import { evaluateTuiIdle, type TuiIdleEvaluationInput } from './tui-idle-evidence'
+import { evaluateAgentStateRules } from './agent-state-rules/agent-state-rules-engine'
+import { TerminalOutputActivity } from './terminal-output-activity'
+
+const PROTOCOLS = '\x1b[?2004h\x1b[>4;2m\x1b[=1;1u'
+const COMPOSER = ['────────────', '>', '────────────', '? for shortcuts']
+
+function input(screen: readonly string[] | null = COMPOSER): TuiIdleEvaluationInput {
+  return {
+    record: { lastAgentStatus: null, lastOscTitle: null, lastOutputAt: 0 },
+    agent: 'antigravity',
+    firstPartyStatus: null,
+    quiescenceMs: 3000,
+    titleObservedAtEpochMs: null,
+    readTailBlockedReason: () => null,
+    readPositiveBodyEvidence: () => false,
+    readQuietReadyBodyEvidence: () =>
+      evaluateAgentStateRules('antigravity', { readScreenLines: () => screen })?.state === 'idle',
+    readAgentRuleVerdict: () =>
+      evaluateAgentStateRules('antigravity', { readScreenLines: () => screen }),
+    readScreenInputVeto: () => false,
+  }
+}
+
+describe('protocol output at a trusted Antigravity composer', () => {
+  afterEach(() => vi.useRealTimers())
+
+  it('becomes ready after three seconds despite two-second input protocol reassertions', () => {
+    vi.useFakeTimers()
+    const evidence = input()
+    evidence.record.outputActivity = new TerminalOutputActivity()
+    for (const at of [0, 2000, 4000, 6000]) {
+      vi.setSystemTime(at)
+      evidence.record.lastOutputAt = at
+      evidence.record.outputActivity.observe(PROTOCOLS, at)
+      expect(evaluateTuiIdle(evidence).kind).toBe(at < 3000 ? 'pending' : 'ready-strong')
+    }
+    expect(evaluateTuiIdle(evidence).kind).toBe('ready-strong')
+    expect(evidence.record.lastOutputAt).toBe(6000)
+  })
+
+  it('preserves the three-second boundary', () => {
+    vi.useFakeTimers()
+    const evidence = input()
+    const activity = new TerminalOutputActivity()
+    evidence.record.outputActivity = activity
+    activity.observe(PROTOCOLS, 0)
+    activity.observe(PROTOCOLS, 2000)
+    evidence.record.lastOutputAt = 2000
+    vi.setSystemTime(2999)
+    expect(evaluateTuiIdle(evidence).kind).toBe('pending')
+    vi.setSystemTime(3000)
+    expect(evaluateTuiIdle(evidence).kind).toBe('ready-strong')
+  })
+
+  it('handles every split of a repeated protocol batch without being ready while incomplete', () => {
+    vi.useFakeTimers()
+    for (let split = 1; split < PROTOCOLS.length; split += 1) {
+      const evidence = input()
+      const activity = new TerminalOutputActivity()
+      evidence.record.outputActivity = activity
+      activity.observe(PROTOCOLS, 0)
+      activity.observe(PROTOCOLS.slice(0, split), 2000)
+      evidence.record.lastOutputAt = 2000
+      vi.setSystemTime(6000)
+      // At complete sequence boundaries there is no unfinished escape to veto input.
+      const complete = [8, 15].includes(split)
+      expect(evaluateTuiIdle(evidence).kind).toBe(complete ? 'ready-strong' : 'pending')
+      activity.observe(PROTOCOLS.slice(split), 6000)
+      expect(evaluateTuiIdle(evidence).kind).toBe('ready-strong')
+    }
+  })
+
+  it.each([
+    'answer', '\r', '\x07', '\x9b?999h', '\x1b[2J', '\x1b[?1049h',
+    '\x1b]0;title\x07', '\x1bPpayload\x1b\\', '\x1bc', '\x1bZ',
+    '\x1b[?999h', '\x1b[>1u', '\x1b[=1;2u', '\x1b[=2;1u',
+    '\x1b[?2004l', '\x1b[>4;1m', `${PROTOCOLS}answer`,
+    `\x1b[${'1'.repeat(600)}m`,
+  ])('requires a fresh quiet interval after other output %j', (data) => {
+    vi.useFakeTimers()
+    const evidence = input()
+    const activity = new TerminalOutputActivity()
+    evidence.record.outputActivity = activity
+    activity.observe(PROTOCOLS, 0)
+    activity.observe(PROTOCOLS, 2000)
+    activity.observe(data, 4000)
+    evidence.record.lastOutputAt = 4000
+    vi.setSystemTime(6999)
+    expect(evaluateTuiIdle(evidence).kind).toBe('pending')
+    vi.setSystemTime(7000)
+    expect(evaluateTuiIdle(evidence).kind).toBe('ready-strong')
+  })
+
+  it('does not interpret protocol settings hidden inside an unfinished control string', () => {
+    vi.useFakeTimers()
+    const evidence = input()
+    const activity = new TerminalOutputActivity()
+    evidence.record.outputActivity = activity
+    activity.observe(PROTOCOLS, 0)
+    activity.observe(`\x1b]0;${PROTOCOLS}`, 2000)
+    vi.setSystemTime(6000)
+    expect(evaluateTuiIdle(evidence).kind).toBe('pending')
+    activity.observe('\x1b', 6000)
+    expect(evaluateTuiIdle(evidence).kind).toBe('pending')
+    activity.observe('\\', 6001)
+    vi.setSystemTime(9000)
+    expect(evaluateTuiIdle(evidence).kind).toBe('pending')
+    vi.setSystemTime(9001)
+    expect(evaluateTuiIdle(evidence).kind).toBe('ready-strong')
+  })
+
+  it('requires the DCS string terminator even after a bell', () => {
+    vi.useFakeTimers()
+    const evidence = input()
+    const activity = new TerminalOutputActivity()
+    evidence.record.outputActivity = activity
+    activity.observe(PROTOCOLS, 0)
+    activity.observe(`\x1bP${PROTOCOLS}\x07`, 2000)
+    vi.setSystemTime(6000)
+    expect(evaluateTuiIdle(evidence).kind).toBe('pending')
+    activity.observe('\x1b\\', 6000)
+    vi.setSystemTime(8999)
+    expect(evaluateTuiIdle(evidence).kind).toBe('pending')
+    vi.setSystemTime(9000)
+    expect(evaluateTuiIdle(evidence).kind).toBe('ready-strong')
+  })
+
+  it.each(['\x1b(', '\x9b2004', '\x1b[1:', '\x9dtitle', `\x1b[${'1'.repeat(600)}`])(
+    'holds incomplete generic escapes and bounded oversized sequences %j', (data) => {
+      vi.useFakeTimers()
+      const evidence = input()
+      const activity = new TerminalOutputActivity()
+      evidence.record.outputActivity = activity
+      activity.observe(PROTOCOLS, 0)
+      activity.observe(data, 2000)
+      vi.setSystemTime(6000)
+      expect(evaluateTuiIdle(evidence).kind).toBe('pending')
+      activity.observe(data.startsWith('\x9d') ? '\x9c' : 'B', 6000)
+      vi.setSystemTime(8999)
+      expect(evaluateTuiIdle(evidence).kind).toBe('pending')
+      vi.setSystemTime(9000)
+      expect(evaluateTuiIdle(evidence).kind).toBe('ready-strong')
+    },
+  )
+
+  it.each([null, ['────────────', '>', '────────────', 'esc to cancel'],
+    ['Trust this workspace?', '> Yes'], ['Select model', '> gemini']])(
+    'refuses an unproven or blocked composer %j', (screen) => {
+      vi.useFakeTimers()
+      const evidence = input(screen)
+      const activity = new TerminalOutputActivity()
+      evidence.record.outputActivity = activity
+      activity.observe(PROTOCOLS, 0)
+      activity.observe(PROTOCOLS, 6000)
+      vi.setSystemTime(6000)
+      expect(evaluateTuiIdle(evidence).kind).toBe('pending')
+    },
+  )
+
+  it('preserves working and overlay vetoes after protocol-only output', () => {
+    vi.useFakeTimers()
+    vi.setSystemTime(6000)
+    const evidence = input()
+    const activity = new TerminalOutputActivity()
+    evidence.record.outputActivity = activity
+    activity.observe(PROTOCOLS, 0)
+    activity.observe(PROTOCOLS, 6000)
+    evidence.firstPartyStatus = { state: 'working', updatedAt: 6000 }
+    expect(evaluateTuiIdle(evidence).kind).toBe('working')
+    evidence.firstPartyStatus = null
+    evidence.readScreenInputVeto = () => true
+    expect(evaluateTuiIdle(evidence).kind).toBe('pending')
+  })
+})
+
+describe('escape scanner activity observations', () => {
+  it('reports non-CSI escapes and unfinished input without treating their payload as text', () => {
+    const other: string[] = []
+    const scanner = createTerminalEscapeScanner({
+      onText: () => {}, onCsi: () => {}, onOtherEscape: (data) => other.push(data),
+    })
+    scanner.observe('\x1b]0;title')
+    expect(scanner.hasPendingEscape()).toBe(true)
+    scanner.observe('\x07')
+    expect(scanner.hasPendingEscape()).toBe(false)
+    expect(other.length).toBeGreaterThan(0)
+    other.length = 0
+    scanner.observe('\x1bc')
+    expect(other.length).toBeGreaterThan(0)
+  })
+})
