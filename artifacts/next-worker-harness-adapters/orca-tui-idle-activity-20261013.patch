+import { createTerminalEscapeScanner } from '../../shared/terminal-escape-scanner'
+
+/** A quiet clock that excludes proven input-mode reassertions, never raw output. */
+export class TerminalOutputActivity {
+  private at = 0
+  private lastActivityAt: number | null = null
+  private readonly modes = new Map<string, string>()
+  private readonly scanner = createTerminalEscapeScanner({
+    onText: (text) => {
+      if (text.length > 0) this.markActivity()
+    },
+    onOtherEscape: () => this.markActivity(),
+    onCsi: (marker, params, final) => {
+      const mode = inputMode(marker, params, final)
+      if (!mode) {
+        this.markActivity()
+      } else if (this.modes.get(mode) !== `${params}${final}`) {
+        this.markActivity(false)
+        this.modes.set(mode, `${params}${final}`)
+      }
+    }
+  })
+
+  observe(data: string, at: number): void {
+    this.at = at
+    this.scanner.observe(data)
+  }
+
+  get quietSince(): number | null {
+    return this.scanner.hasPendingEscape() ? null : this.lastActivityAt
+  }
+
+  get pending(): boolean {
+    return this.scanner.hasPendingEscape()
+  }
+
+  private markActivity(forgetModes = true): void {
+    this.lastActivityAt = this.at
+    // Other output may reset protocol state; only uninterrupted reassertions are proven.
+    if (forgetModes) {
+      this.modes.clear()
+    }
+  }
+}
+
+function inputMode(marker: string, params: string, final: string): string | null {
+  if (marker === '?' && params === '2004' && (final === 'h' || final === 'l')) {
+    return 'bracketed-paste'
+  }
+  if (marker === '>' && /^4;[0-2]$/.test(params) && final === 'm') {
+    return 'modify-other-keys'
+  }
+  if (
+    marker === '=' &&
+    /^[0-9]{1,2};1$/.test(params) &&
+    Number(params.split(';')[0]) <= 31 &&
+    final === 'u'
+  ) {
+    return 'kitty-absolute'
+  }
+  return null
+}
