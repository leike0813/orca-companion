{
  "name": "orca-companion",
  "version": "0.0.0",
  "private": true,
  "description": "为小型软件项目提供可恢复、可追踪、有预算上限的开发流程控制（工作在 Orca CLI 之上）",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.10.0",
  "bin": {
    "orca-companion": "./dist/src/interfaces/cli/main.js"
  },
  "scripts": {
    "build": "tsc --noEmit false --outDir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@langchain/anthropic": "1.5.10",
    "@langchain/openai": "1.5.13",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.16",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "zod": "^4.6.5"
  }
}
